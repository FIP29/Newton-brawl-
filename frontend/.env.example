# Frontend environment variables: paste into Vercel → your project → Settings → Environment Variables.
# For a local production build you can also copy this to frontend/.env.production.local.

# Your Render backend's address (https, no trailing slash). WebSockets use it too (wss://…).
VITE_API_BASE=https://<your-service>.onrender.com

# Leave VITE_API_BASE unset when the backend serves the game itself (one server, same address).
