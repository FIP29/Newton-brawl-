# Copy to .env and fill in (never commit the real .env).
# The address players will open, e.g. https://brawl.example.com (no trailing slash)
PUBLIC_URL=https://brawl.example.com
# Database passwords: make them long and random
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Signs login tokens. Generate with:  openssl rand -base64 48
JWT_SECRET=
