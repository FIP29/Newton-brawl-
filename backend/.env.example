# Backend environment variables: paste these into Render → your service → Environment.
# (This file is a reference; the backend reads real environment variables, not this file.)

# --- Database: Supabase → Connect → Session pooler (NOT "Direct connection") ---
# From:  postgresql://postgres.<project-id>:<password>@<pooler-host>:5432/postgres
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USER=postgres.<project-id>
DB_PASSWORD=<your-supabase-database-password>

# --- Security: signs login tokens. Generate with:  openssl rand -base64 48 ---
JWT_SECRET=<long-random-string>

# --- Your Vercel address(es), comma-separated, https, no trailing slash ---
CORS_ORIGINS=https://<your-project>.vercel.app

# --- Optional ---
# DB_POOL_SIZE=5              # database connections (Supabase free plan: keep it small)
# JWT_EXPIRATION_MINUTES=1440 # how long a login lasts
# PORT is set by Render automatically.
